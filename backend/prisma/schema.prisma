// prisma/schema.prisma
// AyurPass - Production-grade Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?
  passwordHash  String?
  role          Role
  fullName      String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consumer      Consumer?
  professional  Professional?
  provider      Provider?
}

enum Role {
  CONSUMER
  PROFESSIONAL
  PROVIDER_ADMIN
  PLATFORM_ADMIN
}

model Consumer {
  userId            String    @id
  code              String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prakritiPrimary   String?
  prakritiScores    Json?
  preferences       Json?
  location          Unsupported("geography")?

  healthProfiles    HealthProfile[]
  bookings          Booking[]
  consents          ClientConsent[]
  treatmentPlans    TreatmentPlan[]
  orders            Order[]
  loyaltyAccount    LoyaltyAccount?
}

model Provider {
  id                String    @id @default(uuid())
  code              String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  businessName      String
  type              ProviderType
  brandProfile      Json?
  address           Json?
  timezone          String?
  stripeAccountId   String?
  subscriptionTier  String?
  listingTier       String    @default("BOOKING") // FREE_LISTING | BOOKING
  verificationStatus String   @default("pending")
  createdAt         DateTime  @default(now())

  professionals     Professional[]
  services          Service[]
  products          Product[]
  packages          Package[]
  bookings          Booking[]
  treatmentPlans    TreatmentPlan[]
  rooms             Room[]
  orders            Order[]
  integrations      Integration[]
  enquiries         Enquiry[]
  retreats          Retreat[]
}

enum ProviderType {
  AYURVEDA_CLINIC
  AYURVEDA_RESORT
  PANCHAKARMA_CENTER
  WELLNESS_RETREAT
  YOGA_STUDIO
  LUXURY_SPA
  MEDITATION_CENTER
  HEALTH_CLUB
  NUTRITIONIST
  COACHING
  HYBRID
}

model Professional {
  id                      String    @id @default(uuid())
  code                    String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  userId                  String   @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId              String
  provider                Provider  @relation(fields: [providerId], references: [id])
  title                   String?
  specializations         String[]
  doshaExpertise          Json?
  bio                     String?
  certifications          Json?
  yearsExperience         Int?
  hourlyRate              Decimal?  @db.Decimal(10, 2)
  availabilityPreferences Json?
  verificationDocuments   Json?
  rating                  Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount             Int       @default(0)

  services                Service[]
  bookings                Booking[]
  treatmentPlans        TreatmentPlan[]
}

model Service {
  id                 String    @id @default(uuid())
  code               String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id])
  professionalId     String?
  professional       Professional? @relation(fields: [professionalId], references: [id])
  category           ServiceCategory
  name               String
  description        String?
  durationMinutes    Int
  price              Decimal   @db.Decimal(10, 2)
  currency           String    @default("USD")
  imageUrl           String?
  doshaCompatibility Json?
  isVirtual          Boolean   @default(false)
  maxParticipants    Int       @default(1)
  createdAt          DateTime  @default(now())

  bookings           Booking[]
  package            Package?
}

enum ServiceCategory {
  AYURVEDA
  YOGA
  SPA
  MEDITATION
  FITNESS
  NUTRITION
  COACHING
  CONSULTATION
  PACKAGE
}

model Booking {
  id                  String    @id @default(uuid())
  consumerId          String
  consumer            Consumer  @relation(fields: [consumerId], references: [userId])
  serviceId           String
  service             Service   @relation(fields: [serviceId], references: [id])
  professionalId      String?
  professional        Professional? @relation(fields: [professionalId], references: [id])
  providerId          String
  provider            Provider  @relation(fields: [providerId], references: [id])
  roomId              String?
  room                Room?     @relation(fields: [roomId], references: [id])
  startTime           DateTime
  endTime             DateTime
  timezone            String?
  status              BookingStatus @default(PENDING)
  totalAmount         Decimal?  @db.Decimal(10, 2)
  platformCommission  Decimal?  @db.Decimal(10, 2)
  providerPayout      Decimal?  @db.Decimal(10, 2)
  paymentIntentId     String?
  paymentStatus       String    @default("unpaid")
  giftCardRedeemed    Decimal   @default(0) @db.Decimal(10, 2)
  pointsRedeemed      Int       @default(0)
  pointsEarned        Int       @default(0)
  notes               String?
  createdAt           DateTime  @default(now())
}

model Room {
  id          String    @id @default(uuid())
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id])
  name        String
  description String?
  capacity    Int       @default(1)
  hourlyCost  Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  bookings    Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Package {
  id                String    @id @default(uuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id])
  name              String
  description       String?
  totalPrice        Decimal   @db.Decimal(10, 2)
  durationDays      Int?
  includedServices  Json?
  includedProducts  Json?
  doshaFocus        Json?
  isRecurring       Boolean   @default(false)
  createdAt         DateTime  @default(now())

  // Bookable unit auto-managed alongside the package (category PACKAGE)
  serviceId         String?   @unique
  service           Service?  @relation(fields: [serviceId], references: [id])
}

model TreatmentPlan {
  id             String    @id @default(uuid())
  consumerId     String
  consumer       Consumer  @relation(fields: [consumerId], references: [userId])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  providerId     String
  provider       Provider  @relation(fields: [providerId], references: [id])
  name           String?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  phases         Json?
  status         String    @default("active")
  aiGenerated    Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model ClientConsent {
  id             String    @id @default(uuid())
  consumerId     String
  consumer       Consumer  @relation(fields: [consumerId], references: [userId])
  granteeId      String?
  permissionType String
  scope          Json?
  expiresAt      DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
}

model AccessAuditLog {
  id           BigInt    @id @default(autoincrement())
  consumerId   String?
  accessorId   String?
  action       String
  resourceType String
  resourceId   String?
  purpose      String?
  timestamp    DateTime  @default(now())
  ipAddress    String?
}

model HealthProfile {
  id                    String    @id @default(uuid())
  consumerId            String
  consumer              Consumer  @relation(fields: [consumerId], references: [userId])
  vataScore             Decimal?  @db.Decimal(5, 2)
  pittaScore            Decimal?  @db.Decimal(5, 2)
  kaphaScore            Decimal?  @db.Decimal(5, 2)
  questionnaireResponses Json?
  currentImbalances     Json?
  lastAssessment        DateTime?
  updatedAt             DateTime  @default(now())
}

model Product {
  id                    String    @id @default(uuid())
  code                  String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  providerId            String
  provider              Provider  @relation(fields: [providerId], references: [id])
  name                  String
  category              String?
  description           String?
  price                 Decimal?  @db.Decimal(10, 2)
  inventoryQuantity     Int?
  doshaRecommendations  Json?
  images                Json?
  createdAt             DateTime  @default(now())

  orderItems            OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id                 String      @id @default(uuid())
  consumerId         String
  consumer           Consumer    @relation(fields: [consumerId], references: [userId])
  providerId         String
  provider           Provider    @relation(fields: [providerId], references: [id])
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(10, 2)
  platformCommission Decimal?    @db.Decimal(10, 2)
  providerPayout     Decimal?    @db.Decimal(10, 2)
  paymentStatus      String      @default("unpaid")
  paymentIntentId    String?
  giftCardRedeemed   Decimal     @default(0) @db.Decimal(10, 2)
  pointsRedeemed     Int         @default(0)
  pointsEarned       Int         @default(0)
  shippingAddress    Json?
  notes              String?
  createdAt          DateTime    @default(now())

  items              OrderItem[]
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  consumerId     String   @unique
  consumer       Consumer @relation(fields: [consumerId], references: [userId], onDelete: Cascade)
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(uuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String // EARN | REDEEM | ADJUST
  points    Int // signed: positive earn, negative redeem
  reason    String
  createdAt DateTime       @default(now())
}

model GiftCard {
  id             String   @id @default(uuid())
  code           String   @unique
  initialBalance Decimal  @db.Decimal(10, 2)
  balance        Decimal  @db.Decimal(10, 2)
  status         String   @default("active") // active | depleted | void
  purchaserId    String? // consumer userId who purchased it
  recipientEmail String?
  message        String?
  createdAt      DateTime @default(now())

  transactions   GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(uuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type       String // ISSUE | REDEEM | REFUND
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

model Integration {
  id                String    @id @default(uuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id])
  type              String // SQUARE_POS | STRIPE_PAYMENTS | GOOGLE_CALENDAR | ...
  status            String    @default("disconnected")
  externalAccountId String?
  config            Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([providerId, type])
}

/// Lead / enquiry captured from a provider's public listing page.
/// Lets free-listing providers (no AyurPass booking) still receive customers.
model Enquiry {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  retreatId  String?
  retreat    Retreat? @relation(fields: [retreatId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("new") // new | read | archived
  createdAt  DateTime @default(now())

  @@index([providerId, createdAt])
}

/// A dated, multi-day retreat or training program (bookretreats-style).
/// Owned by a Provider (any listing tier); discovered in the /retreats directory.
model Retreat {
  id                 String          @id @default(uuid())
  slug               String          @unique
  providerId         String
  provider           Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title              String
  category           RetreatCategory
  summary            String? // one-line hook for cards
  description        String?
  city               String?
  country            String?
  address            Json?
  startDate          DateTime?
  endDate            DateTime?
  durationDays       Int?
  priceFrom          Decimal?        @db.Decimal(10, 2)
  currency           String          @default("USD")
  capacity           Int?
  skillLevel         String? // All levels | Beginner | Intermediate | Advanced
  images             Json? // string[]
  highlights         Json? // string[]
  inclusions         Json? // string[]
  externalBookingUrl String?
  featured           Boolean         @default(false) // admin "handpicked"
  verificationStatus String          @default("pending")
  status             String          @default("published") // draft | published
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  enquiries          Enquiry[]

  @@index([category, startDate])
  @@index([featured])
}

enum RetreatCategory {
  YOGA_RETREAT
  YOGA_TEACHER_TRAINING
  MEDITATION_RETREAT
  AYURVEDA_PANCHAKARMA
  DETOX_CLEANSE
  SPA_WELLNESS
  FITNESS_ADVENTURE
  SILENT_RETREAT
  WOMENS_RETREAT
  HEALING_RETREAT
  NUTRITION_DETOX
}

/// Platform-curated promotion / deal. Admins create these to spotlight
/// products, services, providers or retreats across any wellness discipline.
model Offer {
  id            String    @id @default(uuid())
  title         String
  description   String?
  /// Discipline this promotion belongs to (AYURVEDA, YOGA, SPA, MEDITATION,
  /// FITNESS, NUTRITION, RETREAT, ...) — free-form so it can span the taxonomy.
  discipline    String?
  /// Display badge, e.g. "20% OFF", "2-for-1", "Free consultation".
  discountLabel String?
  code          String?
  imageUrl      String?
  ctaLabel      String?
  /// Where the promotion sends the visitor (a provider, product, retreat,
  /// a /discover filter, or an external URL).
  ctaUrl        String?
  featured      Boolean   @default(false)
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, featured])
}