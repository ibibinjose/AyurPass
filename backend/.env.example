# AyurPass Backend Environment — copy to .env

DATABASE_URL="postgresql://postgres:password@localhost:5432/ayurpass_dev"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ---------------------------------------------------------------------------
# Stripe Connect (Phase 2)
# Mock mode is ON when STRIPE_SECRET_KEY is unset or ends with "..."
# Paste real test keys (sk_test_… / pk_test_…) to enable live card flows.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret. For local dev, run `npm run stripe:listen` and copy the
# whsec_… it prints. For a deployed endpoint, copy it from the Stripe Dashboard
# (Developers → Webhooks → your endpoint → Signing secret). Required for webhook
# signature verification — the handler rejects unsigned/invalid events.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Twilio (future telehealth)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...