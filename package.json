{
  "name": "ayurpass",
  "version": "1.0.0",
  "private": true,
  "description": "AyurPass — Find & book Ayurveda, Yoga & Wellness (Turborepo monorepo)",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@ayurpass/api --filter=@ayurpass/dashboard",
    "dev:all": "turbo run dev --filter=@ayurpass/api --filter=@ayurpass/dashboard --filter=@ayurpass/mobile",
    "dev:api": "npm run dev -w @ayurpass/api",
    "dev:backend": "npm run dev -w @ayurpass/api",
    "dev:dashboard": "npm run dev -w @ayurpass/dashboard",
    "dev:frontend": "npm run dev -w @ayurpass/dashboard",
    "dev:mobile": "npm run start -w @ayurpass/mobile",
    "start": "concurrently -k -n api,web -c green,yellow \"npm run dev:api\" \"npm run dev:dashboard\"",
    "build": "turbo run build",
    "build:api": "npm run build -w @ayurpass/api",
    "build:backend": "npm run build -w @ayurpass/api",
    "build:dashboard": "npm run build -w @ayurpass/dashboard",
    "build:frontend": "npm run build -w @ayurpass/dashboard",
    "typecheck": "turbo run typecheck",
    "typecheck:mobile": "npm run typecheck -w @ayurpass/mobile",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=@ayurpass/api --filter=@ayurpass/dashboard --filter=@ayurpass/shared",
    "prisma:generate": "npm run prisma:generate -w @ayurpass/api",
    "prisma:migrate": "npm run prisma:migrate -w @ayurpass/api",
    "stripe:status": "node apps/api/scripts/stripe-status.mjs",
    "stripe:listen": "bash scripts/stripe-listen.sh",
    "seed:aaa-scrape": "node apps/api/scripts/scrape-aaa-practitioners.mjs",
    "seed:aaa": "node apps/api/scripts/seed-aaa-practitioners.mjs",
    "seed:aaa:full": "npm run seed:aaa-scrape && npm run seed:aaa",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.5.4"
  }
}
