{
  "name": "ayurpass",
  "version": "1.0.0",
  "private": true,
  "description": "AyurPass — Find & book Ayurveda, Yoga & Wellness",
  "scripts": {
    "start": "concurrently -k -n api,web -c green,yellow \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:dev": "npm run start:dev --workspace @ayurpass/backend",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "build": "npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "typecheck:mobile": "cd mobile && npm run typecheck",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:migrate": "cd backend && npx prisma migrate dev",
    "install:all": "npm install && cd backend && npm install && cd ../mobile && npm install",
    "stripe:status": "node backend/scripts/stripe-status.mjs",
    "stripe:listen": "bash scripts/stripe-listen.sh",
    "seed:aaa-scrape": "node backend/scripts/scrape-aaa-practitioners.mjs",
    "seed:aaa": "node backend/scripts/seed-aaa-practitioners.mjs",
    "seed:aaa:full": "npm run seed:aaa-scrape && npm run seed:aaa",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:mobile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "devDependencies": {
    "concurrently": "^10.0.3",
    "next": "16.2.10",
    "prisma": "^6.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  }
}
