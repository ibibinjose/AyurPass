{
  "expo": {
    "name": "AyurPass",
    "slug": "ayurpass",
    "scheme": "ayurpass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#24382e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayurpass.app"
    },
    "android": {
      "package": "com.ayurpass.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#24382e"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#24382e",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": ""
    }
  }
}
