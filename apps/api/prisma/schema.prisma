// prisma/schema.prisma
// AyurPass - Production-grade Prisma Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?
  passwordHash  String?
  role          Role
  fullName      String?
  avatarUrl     String?
  coverImageUrl String?
  /** When the user confirmed their email via the verification link. */
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consumer      Consumer?
  professional  Professional?
  provider      Provider?
  staffMemberships ProviderStaff[]
  devicePushTokens DevicePushToken[]
  jobApplications JobApplication[]
}

/** Expo / FCM / APNs device tokens for booking reminders and marketing. */
model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?  // ios | android | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Role {
  CONSUMER
  PROFESSIONAL
  PROVIDER_ADMIN
  PLATFORM_ADMIN
}

model Consumer {
  userId            String    @id
  code              String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prakritiPrimary   String?
  prakritiScores    Json?
  preferences       Json?
  location          Unsupported("geography")?

  healthProfiles    HealthProfile[]
  bookings          Booking[]
  consents          ClientConsent[]
  treatmentPlans    TreatmentPlan[]
  orders            Order[]
  loyaltyAccount    LoyaltyAccount?
  clientRecords     ClientRecord[]
  /** Permanent AyurPass wallet identity — one per seeker. */
  wellnessPass      WellnessPass?
  eventTickets      EventTicket[]
}

model Provider {
  id                String    @id @default(uuid())
  code              String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  /** Public URL handle — e.g. /practice/anita-mudnur-ayurveda */
  slug              String?   @unique
  /**
   * Root vanity — ayurpass.com/:handle. Only live when vanityStatus = approved.
   * Admin approval protects brands & celebrities.
   */
  vanityHandle      String?   @unique
  vanityStatus      String    @default("none") // none | pending | approved | rejected
  vanityRequestedAt DateTime?
  vanityReviewedAt  DateTime?
  vanityReviewNote  String?
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id])
  businessName      String
  type              ProviderType
  brandProfile      Json?
  address           Json?
  timezone          String?
  /** ISO 4217 currency code — AUD, USD, GBP, INR, EUR, NZD, etc. */
  currency          String    @default("AUD")
  stripeAccountId   String?
  subscriptionTier  String?
  listingTier       String    @default("BOOKING") // FREE_LISTING | BOOKING
  verificationStatus String   @default("pending")
  /** Business / clinic registration number (AHPRA org, company, local council, etc.) */
  registrationNumber String?
  /** Operating licence / permit number where required */
  licenceNumber     String?
  /**
   * Local health-authority approval marks, e.g.
   * [{ "code":"AAA", "name":"Australian Association of Ayurveda", "region":"AU", "verified":true }]
   */
  healthAuthorities Json?
  /** Aggregated 1–5 star average from Review rows */
  rating            Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount       Int       @default(0)
  likeCount         Int       @default(0)
  dislikeCount      Int       @default(0)
  /** Public catalog lifecycle: live | paused | closed (soft-close). */
  listingStatus     String    @default("live")
  statusChangedAt   DateTime?
  statusReason      String?
  statusChangedBy   String?
  createdAt         DateTime  @default(now())

  professionals     Professional[]
  services          Service[]
  products          Product[]
  packages          Package[]
  bookings          Booking[]
  treatmentPlans    TreatmentPlan[]
  rooms             Room[]
  orders            Order[]
  integrations      Integration[]
  enquiries         Enquiry[]
  retreats          Retreat[]
  clientRecords     ClientRecord[]
  staff             ProviderStaff[]
  jobListings       JobListing[]
  wellnessEvents    WellnessEvent[]
  billingSubscription ClinicSubscription?

  @@index([listingStatus])
}

enum ClinicPlan {
  FREE
  GROWTH
}

enum ClinicSubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

model ClinicSubscription {
  id                   String                   @id @default(uuid())
  providerId           String                   @unique
  provider             Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  stripeCustomerId     String                   @unique
  stripeSubscriptionId String?                  @unique
  stripePriceId        String?
  plan                 ClinicPlan               @default(FREE)
  status               ClinicSubscriptionStatus @default(INACTIVE)
  cancelAtPeriodEnd    Boolean                  @default(false)
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  lastInvoiceId        String?                  @unique
  lastInvoiceStatus    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([plan, status])
  @@index([stripeSubscriptionId])
}

enum ProviderType {
  AYURVEDA_CLINIC
  AYURVEDA_RESORT
  PANCHAKARMA_CENTER
  WELLNESS_RETREAT
  YOGA_STUDIO
  LUXURY_SPA
  MEDITATION_CENTER
  HEALTH_CLUB
  NUTRITIONIST
  COACHING
  /** Ayurvedic / plant-based / mindful cooking kitchens & schools. */
  WELLNESS_KITCHEN
  HYBRID
}

/** Staff role within a provider's team — controls dashboard access level. */
enum StaffRole {
  OWNER
  MANAGER
  RECEPTIONIST
  PRACTITIONER
}

/** Staff invitation status */
enum StaffInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

/**
 * Links users to providers with role-based access.
 * A user can be staff at multiple providers (e.g. locum practitioner).
 * The OWNER role is automatically assigned to the provider creator.
 */
model ProviderStaff {
  id          String            @id @default(uuid())
  providerId  String
  provider    Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        StaffRole         @default(RECEPTIONIST)
  /** Optional JSON for fine-grained permission overrides beyond the role defaults */
  permissions Json?
  /** Email used for invitation (before user accepts and userId is set) */
  inviteEmail String?
  /** Display name for the staff member within this practice */
  displayName String?
  inviteStatus StaffInviteStatus @default(PENDING)
  /** Token sent in the invitation email — used to accept */
  inviteToken  String?          @unique
  invitedAt    DateTime         @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([providerId, userId])
  @@index([inviteEmail])
  @@index([providerId, role])
}

model Professional {
  id                      String    @id @default(uuid())
  code                    String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  /** Legacy public URL — e.g. /me/anita-mudnur */
  slug                    String?   @unique
  /**
   * Username for namespaced public URLs:
   * /pro/:handle · /ayur/:handle · /yoga/:handle · …
   */
  handle                  String?
  handleNamespace         String?   // pro | ayur | yoga | spa | meditation | fitness | nutrition | coach
  /**
   * Root vanity — ayurpass.com/:handle. Admin-approved only.
   */
  vanityHandle            String?   @unique
  vanityStatus            String    @default("none") // none | pending | approved | rejected
  vanityRequestedAt       DateTime?
  vanityReviewedAt        DateTime?
  vanityReviewNote        String?
  userId                  String   @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId              String
  provider                Provider  @relation(fields: [providerId], references: [id])
  /** Free-text title shown on profiles */
  title                   String?
  /**
   * Structured title kind — AYURVEDA_DOCTOR, YOGA_INSTRUCTOR, etc.
   * See shared PROFESSIONAL_TITLE_KINDS.
   */
  titleKind               String?
  specializations         String[]
  doshaExpertise          Json?
  bio                     String?
  certifications          Json?
  yearsExperience         Int?
  hourlyRate              Decimal?  @db.Decimal(10, 2)
  availabilityPreferences Json?
  verificationDocuments   Json?
  /** Practitioner professional registration (e.g. association membership ID) */
  registrationNumber      String?
  /** Practitioner clinical / practice licence number */
  licenceNumber           String?
  /**
   * Local health-authority approval marks for the practitioner
   * (same shape as Provider.healthAuthorities).
   */
  healthAuthorities       Json?
  rating                  Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount             Int       @default(0)
  likeCount               Int       @default(0)
  dislikeCount            Int       @default(0)
  /** Public catalog lifecycle: live | paused | closed (soft-close). */
  listingStatus           String    @default("live")
  statusChangedAt         DateTime?
  statusReason            String?
  statusChangedBy         String?

  services                Service[]
  bookings                Booking[]
  treatmentPlans        TreatmentPlan[]

  @@unique([handleNamespace, handle])
  @@index([handleNamespace, handle])
  @@index([vanityStatus])
  @@index([listingStatus])
}

/**
 * Quality-control review: one star rating (+ optional text) per user per target.
 * Targets: provider | professional | service | product | retreat | offer
 */
model Review {
  id         String   @id @default(uuid())
  userId     String
  targetType String
  targetId   String
  rating     Int
  title      String?
  body       String?
  status     String   @default("published") // published | hidden | flagged
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId, status])
  @@index([userId])
}

/**
 * Like / dislike reaction — one vote per user per target (mutually exclusive).
 */
model Reaction {
  id         String   @id @default(uuid())
  userId     String
  targetType String
  targetId   String
  value      String // like | dislike
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId, value])
  @@index([userId])
}

/**
 * Saved provider or practitioner — persists a member's following list across
 * browsers and devices. Target types are validated by the API.
 */
model Follow {
  id         String   @id @default(uuid())
  userId     String
  targetType String // provider | professional
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

/**
 * Abuse reports & product suggestions — quality / trust & safety.
 * kind: abuse | suggestion
 * Guests may submit with contactEmail; signed-in users set userId.
 */
model FeedbackReport {
  id            String   @id @default(uuid())
  kind          String // abuse | suggestion
  /** spam | harassment | fake | safety | copyright | other | feature | improvement | content */
  category      String
  message       String
  /** Optional listing this is about */
  targetType    String?
  targetId      String?
  targetLabel   String?
  pageUrl       String?
  userId        String?
  contactEmail  String?
  contactName   String?
  status        String   @default("open") // open | reviewing | resolved | dismissed
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind, status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Service {
  id                 String    @id @default(uuid())
  code               String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id])
  professionalId     String?
  professional       Professional? @relation(fields: [professionalId], references: [id])
  category           ServiceCategory
  name               String
  description        String?
  durationMinutes    Int
  price              Decimal   @db.Decimal(10, 2)
  currency           String    @default("USD")
  imageUrl           String?
  doshaCompatibility Json?
  isVirtual          Boolean   @default(false)
  maxParticipants    Int       @default(1)
  /** Denormalized quality signals for catalog cards (targetType = service). */
  rating             Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount        Int       @default(0)
  likeCount          Int       @default(0)
  dislikeCount       Int       @default(0)
  /** Public catalog lifecycle: live | paused | closed (soft-close). */
  listingStatus      String    @default("live")
  statusChangedAt    DateTime?
  statusReason       String?
  statusChangedBy    String?
  createdAt          DateTime  @default(now())

  bookings           Booking[]
  package            Package?

  @@index([listingStatus])
}

enum ServiceCategory {
  AYURVEDA
  YOGA
  SPA
  MEDITATION
  FITNESS
  NUTRITION
  COACHING
  CONSULTATION
  PACKAGE
  /** Wellness cooking classes (Ayurvedic, plant-based, mindful kitchen). */
  COOKING
}

model Booking {
  id                  String    @id @default(uuid())
  consumerId          String
  consumer            Consumer  @relation(fields: [consumerId], references: [userId])
  serviceId           String
  service             Service   @relation(fields: [serviceId], references: [id])
  professionalId      String?
  professional        Professional? @relation(fields: [professionalId], references: [id])
  providerId          String
  provider            Provider  @relation(fields: [providerId], references: [id])
  roomId              String?
  room                Room?     @relation(fields: [roomId], references: [id])
  /**
   * Permanent Wellness Pass this appointment is linked to (for Apple/Google Wallet + door scan).
   */
  wellnessPassId      String?
  wellnessPass        WellnessPass? @relation(fields: [wellnessPassId], references: [id], onDelete: SetNull)
  /** Unique scan token embedded in wallet / QR for this appointment entitlement. */
  checkInToken        String?   @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 12))"))
  checkedInAt         DateTime?
  checkedInByUserId   String?
  startTime           DateTime
  endTime             DateTime
  timezone            String?
  status              BookingStatus @default(PENDING)
  totalAmount         Decimal?  @db.Decimal(10, 2)
  taxAmount           Decimal?  @db.Decimal(10, 2)
  taxRate             Decimal?  @db.Decimal(5, 4)
  taxName             String?
  taxExclusive        Boolean?  @default(false)
  platformCommission  Decimal?  @db.Decimal(10, 2)
  providerPayout      Decimal?  @db.Decimal(10, 2)
  paymentIntentId     String?
  paymentStatus       String    @default("unpaid")
  giftCardRedeemed    Decimal   @default(0) @db.Decimal(10, 2)
  pointsRedeemed      Int       @default(0)
  pointsEarned        Int       @default(0)
  notes               String?
  createdAt           DateTime  @default(now())
  paymentMethod       PaymentMethod?
  posTransactionId    String?

  @@index([wellnessPassId])
  @@index([checkInToken])
}

model Room {
  id          String    @id @default(uuid())
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id])
  name        String
  description String?
  capacity    Int       @default(1)
  hourlyCost  Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  bookings    Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Package {
  id                String    @id @default(uuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id])
  name              String
  description       String?
  totalPrice        Decimal   @db.Decimal(10, 2)
  durationDays      Int?
  includedServices  Json?
  includedProducts  Json?
  doshaFocus        Json?
  isRecurring       Boolean   @default(false)
  createdAt         DateTime  @default(now())

  // Bookable unit auto-managed alongside the package (category PACKAGE)
  serviceId         String?   @unique
  service           Service?  @relation(fields: [serviceId], references: [id])
}

model TreatmentPlan {
  id             String    @id @default(uuid())
  consumerId     String
  consumer       Consumer  @relation(fields: [consumerId], references: [userId])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  providerId     String
  provider       Provider  @relation(fields: [providerId], references: [id])
  name           String?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  phases         Json?
  status         String    @default("active")
  aiGenerated    Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model ClientConsent {
  id             String    @id @default(uuid())
  consumerId     String
  consumer       Consumer  @relation(fields: [consumerId], references: [userId])
  granteeId      String?
  permissionType String
  scope          Json?
  expiresAt      DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
}

model AccessAuditLog {
  id           BigInt    @id @default(autoincrement())
  consumerId   String?
  accessorId   String?
  action       String
  resourceType String
  resourceId   String?
  purpose      String?
  timestamp    DateTime  @default(now())
  ipAddress    String?
}

model HealthProfile {
  id                    String    @id @default(uuid())
  consumerId            String
  consumer              Consumer  @relation(fields: [consumerId], references: [userId])
  vataScore             Decimal?  @db.Decimal(5, 2)
  pittaScore            Decimal?  @db.Decimal(5, 2)
  kaphaScore            Decimal?  @db.Decimal(5, 2)
  questionnaireResponses Json?
  currentImbalances     Json?
  lastAssessment        DateTime?
  updatedAt             DateTime  @default(now())
}

model Product {
  id                    String    @id @default(uuid())
  code                  String    @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  providerId            String
  provider              Provider  @relation(fields: [providerId], references: [id])
  name                  String
  category              String?
  description           String?
  price                 Decimal?  @db.Decimal(10, 2)
  inventoryQuantity     Int?
  doshaRecommendations  Json?
  images                Json?
  createdAt             DateTime  @default(now())

  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id                 String      @id @default(uuid())
  consumerId         String
  consumer           Consumer    @relation(fields: [consumerId], references: [userId])
  providerId         String
  provider           Provider    @relation(fields: [providerId], references: [id])
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(10, 2)
  taxAmount          Decimal?    @db.Decimal(10, 2)
  taxRate            Decimal?    @db.Decimal(5, 4)
  taxName            String?
  taxExclusive       Boolean?    @default(false)
  platformCommission Decimal?    @db.Decimal(10, 2)
  providerPayout     Decimal?    @db.Decimal(10, 2)
  paymentStatus      String      @default("unpaid")
  paymentIntentId    String?
  giftCardRedeemed   Decimal     @default(0) @db.Decimal(10, 2)
  pointsRedeemed     Int         @default(0)
  pointsEarned       Int         @default(0)
  shippingAddress    Json?
  notes              String?
  createdAt          DateTime    @default(now())
  paymentMethod      PaymentMethod?
  posTransactionId   String?

  items              OrderItem[]
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  consumerId     String   @unique
  consumer       Consumer @relation(fields: [consumerId], references: [userId], onDelete: Cascade)
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(uuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String // EARN | REDEEM | ADJUST
  points    Int // signed: positive earn, negative redeem
  reason    String
  createdAt DateTime       @default(now())
}

model GiftCard {
  id             String   @id @default(uuid())
  code           String   @unique
  initialBalance Decimal  @db.Decimal(10, 2)
  balance        Decimal  @db.Decimal(10, 2)
  status         String   @default("active") // active | depleted | void
  purchaserId    String? // consumer userId who purchased it
  recipientEmail String?
  message        String?
  createdAt      DateTime @default(now())

  transactions   GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(uuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type       String // ISSUE | REDEEM | REFUND
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

model Integration {
  id                String    @id @default(uuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id])
  type              String // SQUARE_POS | STRIPE_PAYMENTS | GOOGLE_CALENDAR | ...
  status            String    @default("disconnected")
  externalAccountId String?
  config            Json?
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([providerId, type])
}

/// Stripe webhook events we've already processed, keyed by Stripe's event id.
/// Stripe delivers events at-least-once, so we dedupe on this table to make
/// side effects (loyalty awards, marking paid) exactly-once.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

/// Lead / enquiry captured from a provider's public listing page.
/// Lets free-listing providers (no AyurPass booking) still receive customers.
model Enquiry {
  id         String   @id @default(uuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  retreatId  String?
  retreat    Retreat? @relation(fields: [retreatId], references: [id], onDelete: SetNull)
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("new") // new | read | archived
  createdAt  DateTime @default(now())

  @@index([providerId, createdAt])
}

/// A dated, multi-day retreat or training program (bookretreats-style).
/// Owned by a Provider (any listing tier); discovered in the /retreats directory.
model Retreat {
  id                 String          @id @default(uuid())
  slug               String          @unique
  providerId         String
  provider           Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title              String
  category           RetreatCategory
  summary            String? // one-line hook for cards
  description        String?
  city               String?
  country            String?
  address            Json?
  startDate          DateTime?
  endDate            DateTime?
  durationDays       Int?
  priceFrom          Decimal?        @db.Decimal(10, 2)
  currency           String          @default("USD")
  capacity           Int?
  skillLevel         String? // All levels | Beginner | Intermediate | Advanced
  images             Json? // string[]
  highlights         Json? // string[]
  inclusions         Json? // string[]
  externalBookingUrl String?
  featured           Boolean         @default(false) // admin "handpicked"
  verificationStatus String          @default("pending")
  status             String          @default("published") // draft | published
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  enquiries          Enquiry[]

  @@index([category, startDate])
  @@index([featured])
}

enum RetreatCategory {
  YOGA_RETREAT
  YOGA_TEACHER_TRAINING
  MEDITATION_RETREAT
  AYURVEDA_PANCHAKARMA
  DETOX_CLEANSE
  SPA_WELLNESS
  FITNESS_ADVENTURE
  SILENT_RETREAT
  WOMENS_RETREAT
  HEALING_RETREAT
  NUTRITION_DETOX
}

/// Platform-curated promotion / deal. Admins create these to spotlight
/// products, services, providers or retreats across any wellness discipline.
model Offer {
  id            String    @id @default(uuid())
  title         String
  description   String?
  /// Discipline this promotion belongs to (AYURVEDA, YOGA, SPA, MEDITATION,
  /// FITNESS, NUTRITION, RETREAT, ...) — free-form so it can span the taxonomy.
  discipline    String?
  /// Display badge, e.g. "20% OFF", "2-for-1", "Free consultation".
  discountLabel String?
  code          String?
  imageUrl      String?
  ctaLabel      String?
  /// Where the promotion sends the visitor (a provider, product, retreat,
  /// a /discover filter, or an external URL).
  ctaUrl        String?
  featured      Boolean   @default(false)
  active        Boolean   @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, featured])
}

enum PaymentMethod {
  STRIPE_ONLINE
  CASH
  CARD_TERMINAL
  BANK_TRANSFER
}

model InventoryTransaction {
  id            String                  @id @default(uuid())
  productId     String
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  quantity      Int                     // Positive for stock added, negative for stock removed
  reason        String?                 // e.g. "Stock Take", "Sale", "Damaged", "Return"
  userId        String?                 // User who performed the transaction
  createdAt     DateTime                @default(now())
}

enum InventoryTransactionType {
  ADJUSTMENT
  SALE
  RETURN
  RESTOCK
}

model ClientRecord {
  id          String       @id @default(uuid())
  providerId  String
  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  consumerId  String
  consumer    Consumer     @relation(fields: [consumerId], references: [userId], onDelete: Cascade)
  tags        String[]     // e.g., ["VIP", "Sanskrit Scholar"]
  customFields Json?       // Key-value pairs for customizable CRM data
  status      String       @default("active") // active | inactive | archived
  notes       ClientNote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([providerId, consumerId])
}

model ClientNote {
  id             String       @id @default(uuid())
  clientRecordId String
  clientRecord   ClientRecord @relation(fields: [clientRecordId], references: [id], onDelete: Cascade)
  authorId       String       // User ID of the practitioner / staff who wrote it
  note           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model JobListing {
  id               String           @id @default(uuid())
  code             String           @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  providerId       String
  provider         Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title            String           // e.g. "Lead Ayurvedic Doctor", "Yoga Instructor"
  category         ServiceCategory  // AYURVEDA | YOGA | SPA | MEDITATION | NUTRITION | COACHING | etc.
  employmentType   EmploymentType   @default(FULL_TIME)
  locationType     String           @default("on_site") // on_site | hybrid | remote
  city             String?
  country          String?
  salaryMin        Decimal?         @db.Decimal(10, 2)
  salaryMax        Decimal?         @db.Decimal(10, 2)
  currency         String           @default("AUD")
  experienceYears  Int?
  description      String
  requirements     String?
  status           JobStatus        @default(OPEN)
  featured         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  applications     JobApplication[]

  @@index([providerId, status])
  @@index([category, status])
  @@index([createdAt])
}

model JobApplication {
  id               String            @id @default(uuid())
  jobId            String
  job              JobListing        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantUserId  String
  applicantUser    User              @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  fullName         String
  email            String
  phone            String?
  coverNote        String?
  resumeUrl        String?
  experienceYears  Int?
  status           ApplicationStatus @default(SUBMITTED)
  adminNotes       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([jobId, applicantUserId])
  @@index([jobId, status])
  @@index([applicantUserId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  LOCUM
  CASUAL
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// Wellness Events + permanent Wellness Pass (Apple / Google Wallet)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Short-form wellness events providers host:
 * workshops, cooking classes, sound baths, open days, community circles.
 * Distinct from multi-day Retreats.
 */
model WellnessEvent {
  id                 String        @id @default(uuid())
  code               String        @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 7))"))
  slug               String        @unique
  providerId         String
  provider           Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  hostProfessionalId String?
  title              String
  summary            String?
  description        String?
  category           EventCategory
  /** Free-form tags, e.g. ["dosha-balancing", "family-friendly"]. */
  tags               Json?
  startTime          DateTime
  endTime            DateTime
  timezone           String?
  isVirtual          Boolean       @default(false)
  meetingUrl         String?
  venueName          String?
  address            Json?
  capacity           Int?
  waitlistEnabled    Boolean       @default(true)
  price              Decimal       @default(0) @db.Decimal(10, 2)
  currency           String        @default("AUD")
  isFree             Boolean       @default(false)
  images             Json?
  coverImageUrl      String?
  whatToBring        Json?
  inclusions         Json?
  skillLevel         String?
  status             EventStatus   @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tickets            EventTicket[]

  @@index([providerId, startTime])
  @@index([category, startTime])
  @@index([status, startTime])
}

enum EventCategory {
  AYURVEDA
  YOGA
  SPA
  MEDITATION
  FITNESS
  NUTRITION
  COACHING
  COOKING_CLASS
  SOUND_HEALING
  COMMUNITY
  WORKSHOP
  OPEN_DAY
  RETREAT_PREVIEW
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  REFUNDED
  NO_SHOW
  WAITLISTED
}

/**
 * Permanent digital identity for a wellness seeker.
 * One pass per consumer — survives across appointments and event tickets.
 * Backed by Apple Wallet / Google Wallet when credentials are configured;
 * always has a scannable QR payload for venue check-in.
 */
model WellnessPass {
  id              String    @id @default(uuid())
  consumerId      String    @unique
  consumer        Consumer  @relation(fields: [consumerId], references: [userId], onDelete: Cascade)
  /** Human-readable serial, e.g. AP-7F3A2C1 */
  serialNumber    String    @unique @default(dbgenerated("('AP-' || upper(substr(md5(random()::text), 1, 7)))"))
  /**
   * Stable public token embedded in wallet barcode / QR.
   * Format: AYPASS:{serial}:{secret}
   */
  publicToken     String    @unique @default(dbgenerated("md5(random()::text || clock_timestamp()::text)"))
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  holderName      String?
  /** Apple Wallet pass type identifier when using real certs. */
  applePassTypeId String?
  appleSerial     String?
  /** Google Wallet object id when issued. */
  googleObjectId  String?
  appleUpdatedAt  DateTime?
  googleUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets         EventTicket[]
  bookings        Booking[]
  scanLogs        PassScanLog[]

  @@index([serialNumber])
  @@index([publicToken])
}

model EventTicket {
  id                String        @id @default(uuid())
  code              String        @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 8))"))
  eventId           String
  event             WellnessEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumerId        String
  consumer          Consumer      @relation(fields: [consumerId], references: [userId], onDelete: Cascade)
  wellnessPassId    String?
  wellnessPass      WellnessPass? @relation(fields: [wellnessPassId], references: [id], onDelete: SetNull)
  status            TicketStatus  @default(CONFIRMED)
  quantity          Int           @default(1)
  totalAmount       Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("AUD")
  paymentStatus     String        @default("unpaid") // unpaid | paid | free | refunded
  paymentIntentId   String?
  /** Unique scan token for this ticket (also listed on the permanent pass). */
  checkInToken      String        @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 12))"))
  checkedInAt       DateTime?
  checkedInByUserId String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([eventId, consumerId])
  @@index([eventId, status])
  @@index([consumerId])
  @@index([wellnessPassId])
  @@index([checkInToken])
}

/** Audit trail when a provider scans a pass / ticket / booking QR. */
model PassScanLog {
  id             String        @id @default(uuid())
  wellnessPassId String?
  wellnessPass   WellnessPass? @relation(fields: [wellnessPassId], references: [id], onDelete: SetNull)
  providerId     String?
  scannedByUserId String?
  /** booking | ticket | pass */
  targetKind     String
  targetId       String?
  result         String        // ok | already_checked_in | invalid | expired | wrong_venue
  rawPayload     String?
  createdAt      DateTime      @default(now())

  @@index([wellnessPassId, createdAt])
  @@index([providerId, createdAt])
}


/**
 * Durable transactional outbox. Events are created idempotently at business
 * transitions, then claimed by a background dispatcher. This keeps email
 * delivery independent from request retries and Stripe webhook redelivery.
 */
enum CommunicationKind {
  BOOKING_CONFIRMATION
  PROVIDER_NEW_BOOKING
  BOOKING_REMINDER_24H
  BOOKING_REMINDER_2H
  PAYMENT_RECEIPT
  PROVIDER_PAYMENT_RECEIVED
  PAYMENT_REFUND
  PROVIDER_NEW_ENQUIRY
}

enum CommunicationChannel {
  EMAIL
}

enum CommunicationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model CommunicationDelivery {
  id             String               @id @default(uuid())
  idempotencyKey String               @unique
  kind           CommunicationKind
  channel        CommunicationChannel @default(EMAIL)
  status         CommunicationStatus  @default(PENDING)
  recipientEmail String
  recipientName  String?
  providerId     String?
  bookingId      String?
  orderId        String?
  receiptId      String?
  subject        String
  payload        Json
  scheduledFor   DateTime             @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  attemptCount   Int                  @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, scheduledFor])
  @@index([bookingId, kind])
  @@index([providerId, createdAt])
  @@index([recipientEmail, createdAt])
}

enum ReceiptType {
  PAYMENT
  REFUND
}

/** Immutable tax receipt snapshots, retained independently from mail delivery. */
model Receipt {
  id              String      @id @default(uuid())
  number          String      @unique
  type            ReceiptType
  bookingId       String?
  orderId         String?
  providerId      String
  recipientEmail  String
  recipientName   String?
  currency        String      @default("AUD")
  totalAmount     Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal?    @db.Decimal(10, 2)
  taxRate         Decimal?    @db.Decimal(5, 4)
  taxName         String?
  paymentIntentId String?
  issuedAt        DateTime    @default(now())
  snapshot        Json
  createdAt       DateTime    @default(now())

  @@unique([bookingId, type])
  @@unique([orderId, type])
  @@index([providerId, issuedAt])
  @@index([recipientEmail, issuedAt])
}
