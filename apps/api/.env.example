# AyurPass API (apps/api) — copy to .env
#
# LOCAL DEV: use localhost Postgres only.
# PRODUCTION: set via ECS task env — never commit real secrets.
# See docs/ENVIRONMENTS.md
#

DATABASE_URL="postgresql://postgres:password@localhost:5432/ayurpass_dev"
PORT=4000

# Comma-separated allowlist. Never use * in production (boot will fail).
# Production should list only https://ayurpass.com,https://www.ayurpass.com
# Do NOT add localhost to production CORS.
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Public base URL used in local/disk uploaded image URLs (must be the API host, not the website).
# Production example: https://api.ayurpass.com
# If unset in production, the API falls back to https://api.ayurpass.com (never localhost).
PUBLIC_API_URL="http://localhost:4000"

# Durable media storage (recommended for production / ECS).
# When set, uploads go to S3 under media/ and public URLs use S3_MEDIA_PUBLIC_BASE.
# S3_MEDIA_BUCKET="ayurpass-media-YOUR_ACCOUNT_ID"
# S3_MEDIA_PUBLIC_BASE="https://ayurpass-media-YOUR_ACCOUNT_ID.s3.ap-southeast-2.amazonaws.com"
# AWS_REGION="ap-southeast-2"

# Required in production (NODE_ENV=production or AYURPASS_STRICT=1).
# Do not use the old ayurpass_*_secret development defaults.
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Set to 1 to enforce production rules (secrets, CORS, no mock payments) in staging.
# AYURPASS_STRICT=1

# ---------------------------------------------------------------------------
# Stripe Connect
# Mock mode is ON when STRIPE_SECRET_KEY is unset or ends with "..."
# Mock auto-pay is blocked when NODE_ENV=production or AYURPASS_STRICT=1.
# Paste real test keys (sk_test_… / pk_test_…) to enable card flows.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret. For local dev, run `npm run stripe:listen` and copy the
# whsec_… it prints. For a deployed endpoint, copy it from the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Twilio (future telehealth)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...

# SMTP / Email Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_FROM="AyurPass <noreply@ayurpass.com>"
SMTP_SECURE="false"

# OpenAI-compatible model provider (SCX / MiniMax)
# Never expose this in NEXT_PUBLIC_* variables or frontend code.
SCX_API_KEY=sk-scx-YOUR_KEY_HERE
SCX_BASE_URL="https://api.scx.ai/v1"
SCX_MODEL="MiniMax-M2.7"
