# AyurPass Mobile — copy values into EAS secrets or a local .env
# Used by app.config.ts and src/api.ts

EXPO_PUBLIC_API_URL=http://localhost:4000

# Public website (web checkout fallback when PaymentSheet is unavailable)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional environment label: development | staging | production
# EXPO_PUBLIC_APP_ENV=development
