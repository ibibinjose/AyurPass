# AyurPass Dashboard (apps/dashboard) — copy to .env.local
#
# INDUSTRY STANDARD (secure): local UI → local API only.
# Do NOT set NEXT_PUBLIC_API_URL to https://api.ayurpass.com for daily work.
# Use production at https://ayurpass.com for real accounts.
# See docs/ENVIRONMENTS.md
#
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: paste the same publishable key as apps/api STRIPE_PUBLISHABLE_KEY.
# Checkout also receives this from the API when you pay — this is a fallback only.
# Use Stripe *test* keys locally — never live keys in .env.local
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TtnDLAAMgZ6jXscOpqlUaGWDGNYGzKPqNJNdxaloTRguCsUF03XENVKnZ2IHfbfyc3P4IeK4sa1957nsTNMi2qR00omHLDgpA
# Amplitude Ingestion Key
NEXT_PUBLIC_AMPLITUDE_API_KEY=4b92299d602c27255c18a9ebb12c8fa6